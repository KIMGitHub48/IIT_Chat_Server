[sub_resource type="GDScript" id="GDScript_a6cbh"]
resource_name = "_"
script/source = "extends Node


#region####################### var #################################



#endregion##########################################################

#region##################### @onready ##############################

@onready var authorization_operation = $AuthorizationOperation
@onready var chat_operation = $ChatOperation
@onready var record_operation = $RecordOperation

#endregion##########################################################

#region################# _ready _process ###########################



#endregion##########################################################

#region###################### public ###############################

# #################### AuthorizationOperation ######################

func public_authorization(login, password, remote_sender_id):
	authorization_operation.public_authorization(login, password, remote_sender_id)

# ##################################################################
# ######################## ChatOperation ###########################

func chat_register_login(remote_sender_id, login) -> void:
	chat_operation.chat_register_login(remote_sender_id, login)


func chat_delete_login(remote_sender_id):
	chat_operation.chat_delete_login(remote_sender_id)


func send_chat_public_message(remote_sender_id, message):
	chat_operation.get_chat_public_message(remote_sender_id, message)


func send_chat_private_message(remote_sender_id, message, login_to):
	chat_operation.send_chat_private_message(remote_sender_id, message, login_to)

# ##################################################################
# ####################### RecordOperation ##########################

func create_record(remote_sender_id, querry_dict):
	record_operation.create_record(remote_sender_id, querry_dict)


func update_record(remote_sender_id, querry_dict, target_dict):
	record_operation.update_record(remote_sender_id, querry_dict, target_dict)

# ##################################################################
#endregion##########################################################

#region###################### private ##############################



#endregion##########################################################

#region###################### signal ###############################



#endregion##########################################################
"

[sub_resource type="GDScript" id="GDScript_e8gse"]
resource_name = "_"
script/source = "extends Node


#region####################### var #################################



#endregion##########################################################

#region##################### @onready ##############################

@onready var core_node = get_node(Globals.CORE)

#endregion##########################################################

#region################# _ready _process ###########################



#endregion##########################################################

#region###################### public ###############################

func public_authorization(login, password, remote_sender_id):
	var authorization_passed = false
	var user_access = -1
	var user_database = core_node.database_node.public_get_user_database()
	for user in user_database:
		if user.login == login:
			if user.password == password:
				authorization_passed = true
				user_access = user.access
	if authorization_passed:
		core_node.net_node.public_authorization_passed(true, login, user_access, remote_sender_id)
		access_register(remote_sender_id, login, user_access)
	else:
		core_node.net_node.public_authorization_passed(false, login, user_access, remote_sender_id)

#endregion##########################################################

#region###################### private ##############################

func access_register(remote_sender_id, login, access):
	if (access == 0 or access == 1):
		core_node.operation_node.chat_register_login(remote_sender_id, login)
	else: if access == 2:
		core_node.operation_node.chat_register_login(remote_sender_id, login)
	

#endregion##########################################################

#region###################### signal ###############################



#endregion##########################################################
"

[sub_resource type="GDScript" id="GDScript_h5rxx"]
