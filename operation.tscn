script/source = "extends Node

#region####################### var #################################



#endregion##########################################################

#region##################### @onready ##############################



#endregion##########################################################

#region################# _ready _process ###########################



#endregion##########################################################

#region###################### public ###############################

func create_record(remote_sender_id, querry_dict): 
	if CORE.database_node.create_record(querry_dict):
		CORE.net_node.send_record_database_id(remote_sender_id)


func update_record(remote_sender_id, querry_dict, target_dict):
	if CORE.database_node.update_record(querry_dict, target_dict):
		CORE.net_node.send_record_database_id(remote_sender_id)

#endregion##########################################################

#region###################### private ##############################



#endregion##########################################################

#region###################### signal ###############################



#endregion##########################################################
"

[sub_resource type="GDScript" id="GDScript_8rtkq"]
resource_name = "_"
script/source = "extends Node

#region####################### var #################################

var users:Dictionary

#endregion##########################################################

#region##################### @onready ##############################

@onready var core_node = get_node(Globals.CORE)

#endregion##########################################################

#region################# _ready _process ###########################



#endregion##########################################################

#region###################### public ###############################

func chat_register_login(remote_sender_id, login):
	var user = {
		login = login
	}
	users[remote_sender_id] = user
	core_node.net_node.add_user_to_chat(get_logins_array())


func chat_delete_login(remote_sender_id):##Public
	users.erase(remote_sender_id)


func get_chat_public_message(remote_sender_id ,message):
	var keys = users.keys()
	var user_dict = users.get(remote_sender_id)
	var login = user_dict.login
	core_node.net_node.get_chat_public_message(login, message)


func send_chat_private_message(remote_sender_id, message, login_to):
	var remote_id_to = login_to_remote_id(login_to)
	var login_from = remote_id_to_login(remote_sender_id).login
	CORE.net_node.get_chat_private_message(remote_id_to, message, login_from)
#endregion##########################################################

#region###################### private ##############################
func login_to_remote_id(login):
	var all_users_keys: Array = users.keys()
	for remote_id in all_users_keys:
		if users[remote_id].login == login:
			return remote_id


func remote_id_to_login(remote_id):
	var login = users.get(remote_id)
	return login


func get_logins_array() -> Array:
	var all_users_keys: Array = users.keys()
	var users_array: Array
	for remote_id in all_users_keys:
		users_array.append(users[remote_id].login)
	return users_array

#endregion##########################################################

#region###################### signal ###############################



#endregion##########################################################
"

